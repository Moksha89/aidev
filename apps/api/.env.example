# API configuration
AIDEV_ENV=development
AIDEV_SECRET_KEY=change-me-to-a-32-byte-random-string

# Database
DATABASE_URL=postgresql+psycopg://aidev:aidev@localhost:5432/aidev

# Redis (Celery broker + result backend + pub/sub)
REDIS_URL=redis://localhost:6379/0

# Model server (Ollama / vLLM / llama.cpp)
MODEL_BASE_URL=http://localhost:11434/v1
MODEL_NAME=qwen2.5-coder:14b
MODEL_API_KEY=ollama

# GitHub auth — PAT mode (simplest)
GITHUB_TOKEN=

# GitHub auth — App mode (preferred for teams)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_INSTALLATION_ID=

# CORS — origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://aidev.local

# Sandbox executor: "mock" (default) | "docker" (planned)
SANDBOX_EXECUTOR=mock

# Audit retention
AUDIT_RETENTION_DAYS=365
