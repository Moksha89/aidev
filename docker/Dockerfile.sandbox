# Dockerfile.sandbox — per-task ephemeral sandbox.
#
# This image is what `sandbox-runner` launches for each task. It runs
# as a non-root user, with a read-only root filesystem (enforced at
# `docker run` time), and only `/workspace` is writable.
FROM node:20-bookworm

# Install Python, Playwright deps, GitHub CLI, git.
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-venv \
        git curl ca-certificates jq \
        # Playwright deps
        libnss3 libnspr4 libatk1.0-0 libatk-bridge2.0-0 libcups2 \
        libdbus-1-3 libdrm2 libxkbcommon0 libatspi2.0-0 libxcomposite1 \
        libxdamage1 libxrandr2 libgbm1 libpango-1.0-0 libcairo2 libasound2 \
    && rm -rf /var/lib/apt/lists/*

# GitHub CLI for branch + PR ops inside the sandbox.
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      | gpg --dearmor -o /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update && apt-get install -y gh && rm -rf /var/lib/apt/lists/*

RUN npm install -g pnpm@9 corepack
RUN useradd --uid 10001 --create-home agent \
    && mkdir -p /workspace && chown -R agent:agent /workspace

USER agent
WORKDIR /workspace

# Install Playwright + browsers as the unprivileged user so its cache
# lives under $HOME, not /root.
RUN python3 -m pip install --user --no-cache-dir playwright \
    && python3 -m playwright install --with-deps chromium

# `docker run` should pass --read-only and tmpfs /tmp; the entrypoint
# script in `sandbox-runner` will mount the per-task volume at /workspace.
CMD ["bash", "-lc", "echo 'sandbox ready'; sleep infinity"]
