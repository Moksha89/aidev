# Copy to infra/.env and edit. Never commit the populated file.

AIDEV_DOMAIN=aidev.local

AIDEV_DB_NAME=aidev
AIDEV_DB_USER=aidev
AIDEV_DB_PASSWORD=change-me-now

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AIDEV_SECRET_KEY=change-me

AIDEV_ADMIN_EMAIL=admin@example.com
AIDEV_ADMIN_PASSWORD=change-me-too

# Reach the Ollama/vLLM server on the host. On Linux compose, the
# `host.docker.internal` alias is wired up via `extra_hosts`.
AIDEV_MODEL_BASE_URL=http://host.docker.internal:11434/v1
AIDEV_DEFAULT_MODEL=llama3.1:8b-instruct

# CORS allowlist for the API — comma-separated.
AIDEV_CORS_ORIGINS=http://localhost:3000,https://aidev.local

NEXT_PUBLIC_APP_NAME=AI Developer

# --- sandbox executor ---------------------------------------------------
# `docker` is the production path; CI and local dev can flip back to
# `mock` to skip the Docker daemon.
SANDBOX_EXECUTOR=docker
AIDEV_SANDBOX_IMAGE=aidev/sandbox:latest
AIDEV_SANDBOX_CPUS=2
AIDEV_SANDBOX_MEM_LIMIT=4g
AIDEV_SANDBOX_PIDS_LIMIT=512
AIDEV_SANDBOX_TIMEOUT_SECONDS=1800
AIDEV_SANDBOX_AGENT_UID=10001
AIDEV_SANDBOX_PREVIEW_DOMAIN=preview.aidev.local

# Optional model-server host added to the egress allowlist. Leave
# empty to disable. The model server lives on the GPU host and is
# reached via the egress proxy.
AIDEV_SANDBOX_MODEL_SERVER_HOST=
