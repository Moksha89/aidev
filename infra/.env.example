# Copy to infra/.env and edit. Never commit the populated file.

# Domain is ONLY used in the future production (Traefik+TLS) mode.
# Leave commented out for the IP-only acceptance run.
# AIDEV_DOMAIN=aidev.example.com

AIDEV_DB_NAME=aidev
AIDEV_DB_USER=aidev
AIDEV_DB_PASSWORD=change-me-now

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AIDEV_SECRET_KEY=change-me

AIDEV_ADMIN_EMAIL=admin@example.com
AIDEV_ADMIN_PASSWORD=change-me-too

# Reach the Ollama/vLLM server on the host. On Linux compose, the
# `host.docker.internal` alias is wired up via `extra_hosts`.
AIDEV_MODEL_BASE_URL=http://host.docker.internal:11434/v1
AIDEV_DEFAULT_MODEL=llama3.1:8b-instruct

# CORS allowlist for the API — comma-separated. In IP-only mode include
# the public dashboard URL, e.g. http://<ubuntu-vps-ip>:3000.
AIDEV_CORS_ORIGINS=http://localhost:3000

NEXT_PUBLIC_APP_NAME=AI Developer

# --- agent pipeline -----------------------------------------------------
# v0.4 introduces dual-mode task execution. Both flags must be flipped
# for dashboard tasks to use the real agent-runner / sandbox-runner /
# GitHub PR path. If either flag is missing the API falls back to the
# in-process mock orchestrator (no Docker, no LLM call, no PR open).
#
#   mock + mock   = MVP demo (default)        — safe, in-process
#   real + docker = production agent pipeline — requires GitHub creds
#
# Any other combination is rejected by /settings/runtime — the API
# refuses to start a real pipeline if only one flag is set.
AIDEV_AGENT_PIPELINE=mock

# --- sandbox executor ---------------------------------------------------
# `mock` is the default for safety (in-process, no Docker daemon required).
# Flip to `docker` only when the operator has reviewed the v0.4 readiness
# report and the throwaway-repo smoketest has been approved.
SANDBOX_EXECUTOR=mock
AIDEV_SANDBOX_IMAGE=aidev/sandbox:latest
AIDEV_SANDBOX_CPUS=2
AIDEV_SANDBOX_MEM_LIMIT=4g
AIDEV_SANDBOX_PIDS_LIMIT=512
AIDEV_SANDBOX_TIMEOUT_SECONDS=1800
AIDEV_SANDBOX_AGENT_UID=10001

# --- sandbox preview ----------------------------------------------------
# Two preview modes are supported:
#   port    - IP-only acceptance (default). Allocates one host port from
#             AIDEV_SANDBOX_PREVIEW_PORT_RANGE_{START,END} per task and
#             advertises http://<AIDEV_SANDBOX_PREVIEW_HOST>:<port>. No
#             DNS / TLS / Traefik route required.
#   traefik - Domain-based production mode (future). Writes a per-task
#             dynamic file and routes through
#             https://task-<id>.preview.<AIDEV_SANDBOX_PREVIEW_DOMAIN>.
AIDEV_SANDBOX_PREVIEW_MODE=port

# IP-only (port) mode: the public host advertised in preview URLs and the
# host port range the registrar may allocate from. Set
# AIDEV_SANDBOX_PREVIEW_HOST to the VPS public IP for the acceptance run.
AIDEV_SANDBOX_PREVIEW_HOST=127.0.0.1
AIDEV_SANDBOX_PREVIEW_PORT_RANGE_START=31000
AIDEV_SANDBOX_PREVIEW_PORT_RANGE_END=31999

# Traefik (domain) mode only — ignored when preview mode is `port`.
# AIDEV_SANDBOX_PREVIEW_DOMAIN=preview.aidev.example.com

# Internal port the dev server listens on inside the sandbox container.
# Almost never needs to change.
AIDEV_SANDBOX_PREVIEW_PORT=3000

# Optional model-server host added to the egress allowlist. Leave
# empty to disable. The model server lives on the GPU host and is
# reached via the egress proxy.
AIDEV_SANDBOX_MODEL_SERVER_HOST=
